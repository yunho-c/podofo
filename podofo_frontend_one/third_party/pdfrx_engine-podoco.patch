+/// Finalization applies only to exclusive leases, never to old-style images
+/// whose writable typed-data views can outlive the PdfImage Dart object.
+final class _PdfNativeImageLease implements PdfNativeImageLease, Finalizable {
+  static final _finalizer = NativeFinalizer(malloc.nativeFree);
+  @override
+  final int width;
+  @override
+  final int height;
+  Pointer<Uint8>? _buffer;
+  _PdfNativeImageLease(this.width, this.height, Pointer<Uint8> buffer) : _buffer = buffer {
+    _finalizer.attach(this, buffer.cast(), detach: this, externalSize: retainedBytes);
+  }
+  @override
+  int get rowBytes => width * 4;
+  @override
+  int get initializedBytes => rowBytes * height;
+  @override
+  int get retainedBytes => initializedBytes;
+  @override
+  bool get isReleased => _buffer == null;
+  @override
+  int get address {
+    final buffer = _buffer;
+    if (buffer == null) throw StateError('PDF native image lease is released');
+    return buffer.address;
+  }
+
+  @override
+  void release() {
+    final buffer = _buffer;
+    if (buffer == null) return;
+    _buffer = null;
+    _finalizer.detach(this);
+    malloc.free(buffer);
   }
 }
 
